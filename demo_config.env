# FAST-LIVO Demo 统一配置 — 日常只改本文件
# 生效: 重启 Base / run_mark.sh / run_3.sh

# --- CPU 分核 (Orin NX 6 核: 0-3 簇0, 4-5 簇1) ---
BASE_CPU_AFFINITY=0-3
BASE_OMP_THREADS=4
YOLO_CPU_AFFINITY=4-5
YOLO_NICE=0

# --- 阶段2: YOLO / 测距 ---
IMGSZ=416
CONF=0.30
INFER_HZ=6
DIST_HZ=10
FAST_RENDER=1
STAGE2_LIDAR_R_MAX=25
BBOX_EXPAND_RATIO=0.18
DIST_SAFE_FALLBACK=0
DEFAULT_ON_CLASSES=bottle
DIST_MODE=mask_bbox
DETECTION_HOLD_SEC=0.15
MAX_DETECTIONS=1
LIDAR_STALE_SEC=0.45
DIST_PERCENTILE=10
POSE_HISTORY_SEC=3.0
POSE_SYNC_MAX_DT=0.15
ANCHOR_DISTANCE=0
ANCHOR_MATCH=0
ANCHOR_MIN_SCORE=0.50
ANCHOR_MIN_TEXTURE=8.0
ANCHOR_MIN_REGION_PTS=8
ANCHOR_MATCH_INTERVAL=0.35
ANCHOR_BBOX_EXPAND_RATIO=0.04
ANCHOR_DENSIFY=1
ANCHOR_DENSIFY_STEP=0.03
ANCHOR_DENSIFY_MAX=2500
ANCHOR_SEARCH_MARGIN=2.2
ANCHOR_FULL_SEARCH_INTERVAL=8.0
ANCHOR_KEEP_SEC=1.40
ANCHOR_IDLE_HZ=0.25
SHOW_ANCHOR_BOX=0

# --- UI（overlay 与相机同帧绘制，避免闪烁）---
RENDER_MS=40
OVERLAY_HZ=24

# --- 雷达 / 危险点 / mask 测距 ---
LIDAR_MAX=8000
DANGER_DRAW_MAX=1200
DANGER_DOT_RADIUS=1
DANGER_DIST_MAX=6000
MIN_MASK_PTS=1
CLUSTER_Z_GAP=0.12
MASK_ALPHA=0.35
MASK_POINT_DILATE_PX=5

# --- 模型与数据文件 (相对 my_demo 目录) ---
DANGER_NPZ=danger_points_global.npz
MODEL_PT=yolov8n-seg.pt

# --- 阶段1 标注 ---
MARK_OMP_THREADS=1
ROI_SAVE_MAX=10000
DANGER_TOTAL_MAX=80000
ROI_VOXEL=0.02
ROI_DENSIFY=1
ROI_DENSIFY_STEP=0.02
ROI_DENSIFY_MAX=12000
ROI_DENSIFY_MAX_THICKNESS=0.10
MARK_LINE_WIDTH_PX=18
